+/* Fulqrum: copy n columns of w bytes with one cudaMemcpy or column by
+ * column. It returns 0 if the caller must use cudaMemcpy2D. */
+static int fq_memcpy_cols(cudaError_t *err, void *y, size_t ldy, const void *x,
+      size_t ldx, size_t w, size_t n, enum cudaMemcpyKind kind) {
+   const char *xb = (const char *)x;
+   char *yb = (char *)y;
+   size_t j;
+   int overlap = xb < yb + (ldy * (n - 1) + w) && yb < xb + (ldx * (n - 1) + w);
+   if (w == ldx && w == ldy && !overlap) {
+      *err = cudaMemcpy(y, x, w * n, kind);
+      return 1;
+   }
+   if (ldx <= (size_t)INT_MAX && ldy <= (size_t)INT_MAX) {
+      return 0;
+   }
+   /* Columns can overlap only if ldx is equal to ldy. Copy in a safe order. */
+   if (overlap && (ldx != ldy || (size_t)(xb < yb ? yb - xb : xb - yb) < w)) {
+      return 0;
+   }
+   *err = cudaSuccess;
+   for (j = 0; j < n && *err == cudaSuccess; j++) {
+      size_t c = yb > xb ? n - 1 - j : j;
+      *err = cudaMemcpy(yb + ldy * c, xb + ldx * c, w, kind);
+   }
+   return 1;
+}
+
+/* Fulqrum: set n columns of w bytes to zero with one cudaMemset or column
+ * by column. It returns 0 if the caller must use cudaMemset2D. */
+static int fq_memset_cols(
+      cudaError_t *err, void *x, size_t ldx, size_t w, size_t n) {
+   size_t j;
+   if (w == ldx) {
+      *err = cudaMemset(x, 0, w * n);
+      return 1;
+   }
+   if (ldx <= (size_t)INT_MAX) {
+      return 0;
+   }
+   *err = cudaSuccess;
+   for (j = 0; j < n && *err == cudaSuccess; j++) {
+      *err = cudaMemset((char *)x + ldx * j, 0, w);
+   }
+   return 1;
+}
