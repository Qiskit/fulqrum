include LICENSE.txt
include README.md GPU_INSTALL.md
include requirements.txt
include pytest.ini
recursive-include fulqrum *.pxi
recursive-include fulqrum *.pxd
recursive-include fulqrum *.pyx
recursive-include fulqrum/core/src *.hpp
recursive-include fulqrum/test/data *.json
recursive-include fulqrum/test/data *.json.xz
recursive-include fulqrum/test/data/fe4s4 *.txt.xz
recursive-include fulqrum/include *.hpp
recursive-include fulqrum/core/src/external *.hpp
recursive-include fulqrum/core/src/external *.h
recursive-include fulqrum/core/src/external LICENSE*
include fulqrum/core/src/external/README.md
include fulqrum/include/boost/LICENSE_1_0.txt
recursive-include qiskit-addon-sqd-hpc/include *.hpp
include qiskit-addon-sqd-hpc/LICENSE.txt
include gpu_build.py
recursive-include fulqrum/gpu *.cu *.cuh *.hpp *.h
include fulqrum/gpu/eigensolver/host_dense.cpp fulqrum/gpu/eigensolver/host_gemv.cpp
include fulqrum/gpu/eigensolver/managed_basis.cpp fulqrum/gpu/eigensolver/dense_gpu_offload.cpp
recursive-include patches/primme *.patch
# Ship the pinned PRIMME sources, including header-generation tools, for GPU sdists.
include third-party/primme/makefile third-party/primme/Make_flags
recursive-include third-party/primme/include *.h *.inc
recursive-include third-party/primme/src *.c *.h Makefile deps
recursive-include third-party/primme/src/tools *
include third-party/primme/COPYING.txt third-party/primme/README.rst
# Native artifacts are generated by build_ext; never reuse source-tree binaries.
global-exclude *.so *.so.* *.o *.a
include tests/test_installation_build.py

include fulqrum/gpu/eigensolver/host_pinned_basis.cpp fulqrum/gpu/eigensolver/host_spec.cpp
recursive-include fulqrum *.hpp *.h
